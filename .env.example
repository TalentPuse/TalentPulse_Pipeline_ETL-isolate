# ============================================================
# TalentPulse — pipeline_data environment (warehouse box)
#
# TWO uses, one file:
#   • Local / docker compose:  cp .env.example .env  → fill real values.
#   • GitHub Actions (CI):      CI does NOT read this file. Copy each value into
#     repo → Settings → Secrets and variables → Actions.
#
# Every line is tagged with WHERE it goes in CI:
#   [S]    → Secrets tab
#   [V]    → Variables tab
#   [L]    → LOCAL/compose only — do NOT add to GitHub
#   [web]  → only needed once the talentpulse WEB box exists — SKIP for now
#
# Values below are fake examples showing the format. Replace before use.
# ============================================================


# ════════════════════════════════════════════════════════════
# CI-ONLY — these four have NO local equivalent; they live only in GitHub
# ════════════════════════════════════════════════════════════

# [S] Tailscale OAuth — lets each ephemeral CI runner join the tailnet.
#     Tailscale admin → OAuth clients, scope `auth_keys` (write) + tag `tag:ci`.
#     NOTE: this is a DIFFERENT credential from the `tskey-auth-...` node auth key you
#     use once on the VPS (`tailscale up --auth-key=...`). Don't paste that key here.
#     The SECRET is shown exactly once at creation — copy it before closing the page.
TS_OAUTH_CLIENT_ID=REPLACE_ME_client_id_from_tailscale
TS_OAUTH_SECRET=REPLACE_ME_client_secret_shown_only_once

# [S] Read-only Postgres role for Metabase. The migrate job creates it with this.
#     Generate:  openssl rand -hex 24
METABASE_RO_PASSWORD=REPLACE_ME_openssl_rand_hex_24

# [V] Warehouse box tailnet IP (`tailscale ip -4`). This is DB_HOST for every CI job.
WAREHOUSE_TAILNET_IP=100.101.102.103

# [V][web] Web box tailnet IP — pipelines POST alerts here. Leave BLANK until the
#          website is deployed (alerts just won't dispatch; crawl/dbt/backup still run).
WEB_TAILNET_IP=

# [S][web] Full DSN of the WEB box Postgres, used ONLY by the sync-to-web flow to
#          publish job tables (gold marts + silver views) the website reads. Points
#          at the web box over the tailnet, NOT at the warehouse — a DSN pointing
#          back at the warehouse would make the job overwrite its own source, which
#          is why the flow refuses to start when this is unset instead of defaulting.
#          Leave BLANK until the web box exists; only pipeline-sync-to-web.yml needs it.
WEB_DATABASE_URL=


# ════════════════════════════════════════════════════════════
# PostgreSQL
# ════════════════════════════════════════════════════════════

# [S] POSTGRES_* CREATE the user (compose / deploy.yml); DB_* CONNECT as it (pipelines).
#     All four MUST hold identical values, or compose makes user A and CI logs in as B.
POSTGRES_USER=admin
POSTGRES_PASSWORD=s7Kd2mQx9RtVwZ4p          # example only — generate your own
DB_USER=admin
DB_PASSWORD=s7Kd2mQx9RtVwZ4p                # same value as POSTGRES_PASSWORD

# [V] Database name.
DB_NAME=warehouse

# [L] Local/compose only. In compose this is the docker DNS name "postgres";
#     in CI the host is WAREHOUSE_TAILNET_IP (above), NOT this line.
DB_HOST=postgres
DB_PORT=5432

# [L] URL-encoded copy of POSTGRES_PASSWORD (prefect's DSN breaks on @ : / # in a
#     plain URI). deploy.yml generates this itself; set by hand ONLY for manual compose.
#     python3 -c "from urllib.parse import quote_plus; print(quote_plus('YOUR_PASSWORD'))"
DB_PASSWORD_ENCODED=s7Kd2mQx9RtVwZ4p


# ════════════════════════════════════════════════════════════
# Cloudflare R2 (object storage — S3 API)
# ════════════════════════════════════════════════════════════

# [S] Bucket must ALREADY EXIST — the app does not create it. ACCOUNT_ID = 32-hex
#     string in the R2 dashboard's right sidebar.
S3_ENDPOINT_URL=https://1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d.r2.cloudflarestorage.com
S3_ACCESS_KEY=9f8e7d6c5b4a3f2e1d0c9b8a7f6e5d4c                                      # 32 hex
S3_SECRET_KEY=3c2b1a0f9e8d7c6b5a4f3e2d1c0b9a8f7e6d5c4b3a2f1e0d9c8b7a6f5e4d3c2b    # 64 hex

# [V] Raw-crawl bucket.
S3_BUCKET_NAME=talentpulse-raw

# [L] R2 wants "auto" (code default "us-east-1" is a MinIO leftover). Not a GitHub key.
S3_REGION=auto


# ════════════════════════════════════════════════════════════
# LLM skill extraction
# ════════════════════════════════════════════════════════════

# [S] An OPENROUTER key despite the name — configs/skill_extraction.yaml sets
#     api_key_env: "OPENAI_API_KEY" but points base_url at OpenRouter.
OPENAI_API_KEY=sk-or-v1-0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# [L] blank = no cap; set a number to limit a single run.
SKILL_MAX_JOBS=


# ════════════════════════════════════════════════════════════
# Prefect
# ════════════════════════════════════════════════════════════

# [S] What the browser UI calls; compose / deploy.yml uses this one.
PREFECT_UI_API_URL=http://localhost:4200/api

# [L] Where flows REPORT runs. Unset = ephemeral local mode (runs, but no history/UI).
PREFECT_API_URL=http://localhost:4200/api

# [L] "1" registers a long-lived .serve() cron deployment. CI leaves this UNSET —
#     the schedule lives in the workflow cron, not in Prefect. Do not set it in CI.
PREFECT_DEPLOY=0


# ════════════════════════════════════════════════════════════
# Backup  (read by src/backup/r2_backup.py)
# ════════════════════════════════════════════════════════════

# [V] Backups get their OWN bucket, so a bad prefix/lifecycle rule on the raw bucket
#     can never reach them.
BACKUP_BUCKET=talentpulse-backup
PARQUET_SCHEMAS=dbt_dev_gold,dbt_dev_feature

# [V] Grandfather-father-son retention: daily → weekly → monthly, so late-noticed
#     corruption is still recoverable. ~2 years keeps ~31 files / ~141MB.
KEEP_DAILY_DAYS=14
KEEP_WEEKLY_WEEKS=8
KEEP_MONTHLY_MONTHS=12
# [V] Floor: never prune below this many, however old.
MIN_KEEP_DUMPS=7

# [L] Local-dev only: run pg_dump inside the named container. MUST be empty in CI
#     (the worker image ships a real pg_dump).
BACKUP_PGDUMP_VIA_DOCKER=


# ════════════════════════════════════════════════════════════
# Alert dispatch (pipeline → website backend) — [web] SKIP all of these for now
# ════════════════════════════════════════════════════════════

# [L] Where pipelines POST alerts. CI builds this from WEB_TAILNET_IP; local uses localhost.
DASHBOARD_API_URL=http://localhost:8001

# [S][web] MUST equal the backend's TELEGRAM_WEBHOOK_SECRET — the backend checks this exact
#          value on /api/admin/alerts/dispatch-internal (admin.py:181). Do NOT invent a new
#          one. python -c "import secrets; print(secrets.token_urlsafe(32))"
ALERT_DISPATCH_SECRET=Hn4vQ2_pXsL9tRcW7yKmBd3ZgFjA6eUw

# [S][web] Fallback used when ALERT_DISPATCH_SECRET is unset. Backend refuses weak placeholders.
TELEGRAM_WEBHOOK_SECRET=Yq7Tz2NmVb8_KpR4xLdW6sJgH3fCe9Au

# [S][web] <bot_id>:<35-char token> from BotFather. Consumed by compose/deploy.yml.
TELEGRAM_BOT_TOKEN=1234567890:AAF-ExampleTokenReplaceWithRealOne1234


# ════════════════════════════════════════════════════════════
# Crawl scope — [V] all optional, workflow defaults are sane
# ════════════════════════════════════════════════════════════

VNW_KEYWORDS=Data Engineer,AI Engineer,Business Analyst,Business Development,Technical Sales
ITVIEC_KEYWORDS=data-engineer,ai-engineer,data-analyst
ALLOWED_FUNCTION_IDS=25,27,129,130
FOCUS_KEYWORDS=data engineer,data analyst,ai,machine learning,data science,data scientist,big data,analytics,business development,business analyst,technical sales
SKIP_FOCUS_SOURCES=itviec

LINKEDIN_KEYWORDS=Data Engineer,Data Analyst,AI Engineer,Data Scientist,Business Analyst,Machine Learning
LINKEDIN_TITLE_KEYWORDS=Data Engineer,Data Analyst,AI Engineer,Data Scientist,Business Analyst,Machine Learning
LINKEDIN_GEO_ID=104195383
LINKEDIN_RATE_SECONDS=3.0
# LINKEDIN_PROXY_URL=http://user:pass@proxy:port   # [S] only if you route LinkedIn via a proxy

# [V] A REAL contact email — goes into the crawler User-Agent so sites can reach you.
CRAWLER_CONTACT_EMAIL=your-email@example.com


# ════════════════════════════════════════════════════════════
# Crawler tuning — [L] all optional, code defaults are fine
# ════════════════════════════════════════════════════════════

CRAWLER_USER_AGENT=          # defaults to "TalentPulseBot/1.0 (+CRAWLER_CONTACT_EMAIL)"
LISTING_MAX_PAGES=5
CRAWLER_RATE_SECONDS=2.5     # seconds between requests
CRAWLER_BURST=2             # requests back-to-back before rate limiting
CRAWLER_REQUEST_TIMEOUT=20   # seconds
CRAWLER_RECRAWL_DAYS=7       # skip a job seen more recently than this
CRAWLER_KILL_SWITCH=0        # "1" = every crawler exits immediately without a request
