# ============================================================
# TalentPulse — pipeline_data environment variables
# Copy to .env and fill in real values:  cp .env.example .env
#
# WHO READS THIS FILE
#   - `docker compose up` on the VPS (postgres / prefect-server / metabase)
#   - local runs of the crawlers, dbt, and scripts/
#
# WHO DOES *NOT*
#   - CI. deploy.yml writes its own .env from GitHub Secrets, and the
#     pipeline-*.yml workflows pass env straight into `docker run`. If you add a
#     variable here that a flow needs, you must ALSO add it to that workflow's
#     `env:` block AND to the `-e` list in .github/actions/run-flow/action.yml —
#     otherwise it is silently dropped and the code falls back to its default.
#
# Every variable below is read by real code. Grouped by what breaks without it.
# ============================================================


# ════════════════════════════════════════════════════════════
# REQUIRED — nothing works without these
# ════════════════════════════════════════════════════════════

# ── PostgreSQL ──────────────────────────────────────────────
# Two pairs on purpose, and they MUST hold the same values:
#   POSTGRES_*  -> docker-compose.yml, to CREATE the superuser
#   DB_*        -> src/utils/config.py, to CONNECT as it
# If they drift, compose creates user A and every pipeline logs in as user B.
POSTGRES_USER=admin
POSTGRES_PASSWORD=s7Kd2mQx9RtVwZ4p          # example only — generate your own
DB_USER=admin
DB_PASSWORD=s7Kd2mQx9RtVwZ4p                # same value as POSTGRES_PASSWORD
DB_HOST=postgres          # docker DNS. From a GHA runner this is the VPS tailnet IP.
DB_PORT=5432
DB_NAME=warehouse

# URL-encoded copy of POSTGRES_PASSWORD — prefect-server's DSN in
# docker-compose.yml needs it, because a password containing @ : / # breaks a
# postgresql:// URI. deploy.yml generates this itself; set it by hand only when
# bringing compose up manually.
#   python3 -c "from urllib.parse import quote_plus; print(quote_plus('YOUR_PASSWORD'))"
DB_PASSWORD_ENCODED=s7Kd2mQx9RtVwZ4p

# ── Object storage: Cloudflare R2 (S3-compatible) ────────────
# MinIO is gone; raw crawled HTML lands in R2. The bucket must ALREADY EXIST —
# the app does not create it on first run. See docs/gha-migration-runbook.md (a).
# ACCOUNT_ID is the 32-hex string in the R2 dashboard's right sidebar.
S3_ENDPOINT_URL=https://1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d.r2.cloudflarestorage.com
S3_ACCESS_KEY=9f8e7d6c5b4a3f2e1d0c9b8a7f6e5d4c          # 32 hex chars
S3_SECRET_KEY=3c2b1a0f9e8d7c6b5a4f3e2d1c0b9a8f7e6d5c4b3a2f1e0d9c8b7a6f5e4d3c2b  # 64 hex
S3_BUCKET_NAME=talentpulse-raw
# The code default is still "us-east-1", a MinIO leftover. R2 wants "auto".
S3_REGION=auto


# ════════════════════════════════════════════════════════════
# REQUIRED per feature — the feature is dead without its var
# ════════════════════════════════════════════════════════════

# ── LLM skill extraction ────────────────────────────────────
# Despite the name this is an OPENROUTER key: configs/skill_extraction.yaml sets
# api_key_env: "OPENAI_API_KEY" but points base_url at OpenRouter.
OPENAI_API_KEY=sk-or-v1-0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SKILL_MAX_JOBS=              # blank = no cap. Set a number to limit a single run.

# ── Alert dispatch (pipeline -> dashboard backend) ──────────
DASHBOARD_API_URL=http://tp-backend:8001
# Shared secret the backend checks on /api/admin/alerts/dispatch-internal.
# Must match the backend's value exactly.
ALERT_DISPATCH_SECRET=Hn4vQ2_pXsL9tRcW7yKmBd3ZgFjA6eUw
# Fallback used when ALERT_DISPATCH_SECRET is unset (see flows/_shared.py).
# NOTE: the backend now REFUSES TO START on placeholders like "dev-webhook-secret".
# Generate a real one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=Yq7Tz2NmVb8_KpR4xLdW6sJgH3fCe9Au

# Consumed by docker-compose / deploy.yml, not by pipeline_data's Python.
# Format: <bot_id>:<35-char token> from BotFather.
TELEGRAM_BOT_TOKEN=1234567890:AAF-ExampleTokenReplaceWithRealOne1234

# ── Prefect ─────────────────────────────────────────────────
# PREFECT_API_URL: where flows REPORT their runs. Unset = ephemeral local mode
#   (the flow still runs; you just lose the run history and the UI).
# PREFECT_UI_API_URL: what the browser UI calls. compose/deploy.yml uses this one.
PREFECT_API_URL=http://localhost:4200/api
PREFECT_UI_API_URL=http://localhost:4200/api
# "1" makes a flow register a long-lived .serve() cron deployment instead of
# running once. GitHub Actions deliberately leaves this UNSET — the schedule lives
# in the workflow cron, not in Prefect. Do not set it in CI.
PREFECT_DEPLOY=0


# ════════════════════════════════════════════════════════════
# BACKUP — read by src/backup/r2_backup.py
# ════════════════════════════════════════════════════════════

# Backups get their OWN bucket, separate from the raw-crawl one, so a bad prefix
# or a lifecycle rule on talentpulse-raw can never reach them.
BACKUP_BUCKET=talentpulse-backup
PARQUET_SCHEMAS=dbt_dev_gold,dbt_dev_feature

# Grandfather-father-son retention. Backups thin out (daily -> weekly -> monthly)
# instead of falling off a single cliff, because the failure that matters is
# corruption noticed LATE: a flat "delete after 30 days" leaves you nothing once
# the bad data is 31 days old. Two years of daily runs keeps ~31 files / ~141MB,
# which is 1.4% of R2's 10GB free tier — there is no reason to keep less.
KEEP_DAILY_DAYS=14
KEEP_WEEKLY_WEEKS=8
KEEP_MONTHLY_MONTHS=12
# Floor: never prune below this many, however old. A backup system that can delete
# its way to zero is not a backup system.
MIN_KEEP_DUMPS=7

# Local-dev only: run pg_dump inside the named container instead of from PATH, so
# you can back up from a machine with no postgres client installed.
# MUST be empty in CI — the worker image ships a real pg_dump.
BACKUP_PGDUMP_VIA_DOCKER=


# ════════════════════════════════════════════════════════════
# OPTIONAL — all have working defaults; override to tune
# ════════════════════════════════════════════════════════════

# ── What to crawl ───────────────────────────────────────────
VNW_KEYWORDS=Data Engineer,AI Engineer,Business Analyst,Business Development,Technical Sales
ITVIEC_KEYWORDS=data-engineer,ai-engineer,data-analyst
ALLOWED_FUNCTION_IDS=25,27,129,130
FOCUS_KEYWORDS=data engineer,data analyst,ai,machine learning,data science,data scientist,big data,analytics,business development,business analyst,technical sales
SKIP_FOCUS_SOURCES=itviec

# ── LinkedIn ────────────────────────────────────────────────
LINKEDIN_KEYWORDS=Data Engineer,Data Analyst,AI Engineer,Data Scientist,Business Analyst,Machine Learning
LINKEDIN_TITLE_KEYWORDS=Data Engineer,Data Analyst,AI Engineer,Data Scientist,Business Analyst,Machine Learning
LINKEDIN_GEO_ID=104195383
LINKEDIN_RATE_SECONDS=3.0
# LINKEDIN_PROXY_URL=http://user:pass@proxy:port

# ── Crawler politeness & safety ─────────────────────────────
# CRAWLER_CONTACT_EMAIL goes into the User-Agent so the sites can reach you. Set it
# to something real — it is the difference between a polite bot and an anonymous
# one that gets blocked.
CRAWLER_CONTACT_EMAIL=your-email@example.com
# Defaults to "TalentPulseBot/1.0 (+CRAWLER_CONTACT_EMAIL)". Override only to send
# a different UA string.
CRAWLER_USER_AGENT=
LISTING_MAX_PAGES=5
CRAWLER_RATE_SECONDS=2.5      # seconds between requests
CRAWLER_BURST=2               # requests allowed back-to-back before rate limiting
CRAWLER_REQUEST_TIMEOUT=20    # seconds
CRAWLER_RECRAWL_DAYS=7        # skip a job seen more recently than this
# Emergency stop: "1" makes every crawler exit immediately without a request. Flip
# this if a site complains, instead of scrambling to tear down the schedule.
CRAWLER_KILL_SWITCH=0
